HIGHLIGHT = '<span background="#3584e4" bgalpha="32%" foreground="#ffffff">{}</span>'


def highlight_markup(old, new):
    """Markup for new with the changed words highlighted, plus a list of 'old → new' changes."""
    tokenize = lambda s: re.findall(r"\s+|\w+|[^\w\s]", s)
    a, b = tokenize(old), tokenize(new)
    out, changes = [], []
    for op, i1, i2, j1, j2 in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes():
        added = "".join(b[j1:j2])
        if op == "equal":
            out.append(html.escape(added))
            continue
        removed = "".join(a[i1:i2]).strip()
        if added.strip():
            lead = added[:len(added) - len(added.lstrip())]
            trail = added[len(added.rstrip()):]
            out.append(lead + HIGHLIGHT.format(html.escape(added.strip())) + trail)
        else:
            out.append(html.escape(added))
        if removed or added.strip():
            changes.append(f"{removed or '∅'} → {added.strip() or '∅'}")
    return "".join(out), changes


def md_markup(text):
    """Escape text and turn **bold** and `code` into Pango markup."""
    text = html.escape(text)
    text = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", text)
    return re.sub(r"`([^`]+)`", r"<tt>\1</tt>", text)


def label(text="", css="", markup=False, wrap=True, xalign=0, selectable=False):
    w = Gtk.Label(xalign=xalign, wrap=wrap, wrap_mode=Pango.WrapMode.WORD_CHAR, selectable=selectable)
    (w.set_markup if markup else w.set_text)(text)
    for c in css.split():
        w.add_css_class(c)
    return w


def kbd(keys, text, action=None, primary=False):
    """A footer hint: key caps followed by a word, clickable when it has an action."""
    box = Gtk.Box(spacing=6)
    for k in keys.split():
        box.append(label(k, "kbd", wrap=False))
    word = label(text, wrap=False)
    box.append(word)
    btn = Gtk.Button(child=box, focusable=False)
    btn.add_css_class("flat")
    btn.add_css_class("hint")
    if primary:
        btn.add_css_class("primary")
    if action:
        btn.connect("clicked", lambda _b: action())
    btn.word = word
    return btn


def vbox(spacing=0, css=""):
    b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=spacing)
    for c in css.split():
        b.add_css_class(c)
    return b


def divider(vertical=False):
    d = Gtk.Box()
    d.add_css_class("divider")
    return d


def clear(box):
    while child := box.get_first_child():
        box.remove(child)


class Popup(Adw.ApplicationWindow):
    VERSIONS = (("fixed", "FIXED", "⌥1"), ("improved", "IMPROVED", "⌥2"), ("mine", "MY DRAFT", "⌥3"))
    NAMES = {"fixed": "Fixed", "improved": "Improved", "mine": "My draft"}

    def __init__(self, app):
        super().__init__(application=app, title="Saywell", default_width=1040, default_height=660)
        self.add_css_class("popup")
        self.analysis = None        # latest --json result
        self.history = []           # follow-up questions and answers
        self.proc = None            # running analysis
        self.choice = "fixed"
        self.inserted = None        # text to paste after the window closes

        # Top bar: the draft, like a launcher's search field.
        self.input = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, accepts_tab=False, hexpand=True)
        self.input.add_css_class("draft")
        self.input.update_property([Gtk.AccessibleProperty.LABEL], ["Draft"])
        placeholder = label("Type your message — Chinese words are fine", "dim draft", wrap=False)
        placeholder.set_can_target(False)
        placeholder.set_valign(Gtk.Align.START)
        self.input.get_buffer().connect("changed", lambda b: placeholder.set_visible(b.get_char_count() == 0))
        draft = Gtk.Overlay(child=Gtk.ScrolledWindow(child=self.input, min_content_height=28, max_content_height=130,
                                                     propagate_natural_height=True, hexpand=True,
                                                     hscrollbar_policy=Gtk.PolicyType.NEVER))
        draft.add_overlay(placeholder)
        top = Gtk.Box(spacing=12)
        top.add_css_class("topbar")
        top.append(draft)
        check = kbd("⌃ ↵", "Check", self.analyze)
        check.set_valign(Gtk.Align.START)
        top.append(check)

        # Left: versions as selectable cards, then the meaning check.
        self.versions = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.versions.add_css_class("versions")
        self.versions.connect("row-selected", self.on_row_selected)
        self.versions.connect("row-activated", lambda _l, row: self.use_as_draft(row.key))
        self.left_empty = label("Press ⌃↵ to check your draft.\nVersions appear here.", "dim", xalign=0.5)
        self.left_empty.set_justify(Gtk.Justification.CENTER)
        self.left_empty.set_vexpand(True)
        left = vbox(10, "pane")
        left.append(self.left_empty)
        left.append(self.versions)
        left_scroll = Gtk.ScrolledWindow(child=left, hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)

        # Right: progress while checking, then the follow-up chat with its entry pinned at the bottom.
        # 知识点 are not made here: `saywell --learn` extracts them offline from the log.
        self.progress = vbox(10)
        self.progress.append(label("CHECKING", "eyebrow"))
        self.bar = Gtk.ProgressBar()
        self.progress.append(self.bar)
        self.steps = vbox(6)
        self.progress.append(self.steps)
        self.progress.set_visible(False)
        self.chat = vbox(10)
        self.chat_intro = vbox(4)
        self.chat_intro.append(label("追问", "eyebrow"))
        self.chat_intro.append(label("Why this word? Too formal? Ask about any change.", "dim"))
        self.meaning = vbox(6)   # meaning check, shown here once the progress is done
        self.meaning.set_visible(False)
        right = vbox(14, "pane")
        right.append(self.progress)
        right.append(self.meaning)
        right.append(self.chat_intro)
        right.append(self.chat)
        self.right_scroll = Gtk.ScrolledWindow(child=right, hscrollbar_policy=Gtk.PolicyType.NEVER,
                                               vexpand=True)
        self.ask = Gtk.Entry(placeholder_text="Ask a follow-up…  e.g. why not “ensure”?")
        self.ask.add_css_class("ask")
        self.ask.connect("activate", self.on_ask)
        ask_box = vbox(0, "pane")
        ask_box.append(self.ask)
        right_col = vbox()
        right_col.append(self.right_scroll)
        right_col.append(ask_box)

        body = Gtk.Paned(position=560, shrink_start_child=False, shrink_end_child=False, vexpand=True)
        body.set_start_child(left_scroll)
        body.set_end_child(right_col)

        # Footer: key hints, clickable.
        footer = Gtk.Box(spacing=4)
        footer.add_css_class("footer")
        footer.append(kbd("esc", "Cancel", self.close))
        footer.append(kbd("⌥ 1-3", "Pick"))
        footer.append(kbd("⌥ ↵", "Edit in draft", lambda: self.use_as_draft(self.choice)))
        self.status = label("", "dim", wrap=False, xalign=1)
        self.status.set_hexpand(True)
        self.status.set_margin_end(10)
        footer.append(self.status)
        self.insert_hint = kbd("⌃ ⇧ ↵", "Insert Fixed", self.insert, primary=True)
        footer.append(self.insert_hint)

        root = vbox()
        root.append(top)
        root.append(divider())
        root.append(body)
        root.append(divider())
        root.append(footer)
        self.toasts = Adw.ToastOverlay(child=root)
        self.set_content(self.toasts)
        self.show_results(False)

        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        self.connect("close-request", lambda *_: self.stop() or False)
        self.set_focus(self.input)

    # ---- keys -------------------------------------------------------------

    def on_key(self, _ctl, keyval, _code, state):
        ctrl = state & Gdk.ModifierType.CONTROL_MASK
        shift = state & Gdk.ModifierType.SHIFT_MASK
        alt = state & Gdk.ModifierType.ALT_MASK
        if keyval == Gdk.KEY_Escape:
            self.close()
        elif keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and ctrl and shift:
            self.insert()
        elif keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and ctrl:
            self.analyze()
        elif keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and alt:
            self.use_as_draft(self.choice)
        elif alt and keyval in (Gdk.KEY_1, Gdk.KEY_2, Gdk.KEY_3):
            self.pick(self.VERSIONS[keyval - Gdk.KEY_1][0])
        else:
            return False
        return True

    # ---- analysis ---------------------------------------------------------

    def draft(self):
        buf = self.input.get_buffer()
        return buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip()

    # Steps shown while checking, and the model sections that belong to each.
    STEPS = (("Fixing grammar", ("fixed",)), ("Improving wording", ("improved", "why")),
             ("Translating back · 含义", ("fixed_zh", "improved_zh")), ("Checking meaning", ("flag",)))

    def set_status(self, text="", busy=False):
        self.status.set_text(text)

    def start_progress(self):
        self.step = 0
        self.fraction = 0.0
        self.progress.set_visible(True)
        self.chat_intro.set_visible(False)
        self.meaning.set_visible(False)
        self.show_steps()
        if not getattr(self, "ticker", None):
            self.ticker = GLib.timeout_add(80, self.tick)

    def set_stage(self, stage):
        for i, (_, stages) in enumerate(self.STEPS):
            if stage in stages and i > self.step:
                self.step = i
                self.show_steps()

    def show_steps(self):
        clear(self.steps)
        for i, (name, _) in enumerate(self.STEPS):
            mark, css = (("✓", "step-done") if i < self.step else ("●", "step-active") if i == self.step
                         else ("○", "step-todo"))
            self.steps.append(label(f"{mark}  {name}", f"step {css}", wrap=False))

    def tick(self):
        # Ease toward the end of the current step; the model gives no finer progress than that.
        target = (self.step + 0.9) / len(self.STEPS)
        self.fraction += (target - self.fraction) * 0.04
        self.bar.set_fraction(self.fraction)
        return True

    def stop_progress(self, ok):
        if getattr(self, "ticker", None):
            GLib.source_remove(self.ticker)
            self.ticker = None
        if ok:
            self.step = len(self.STEPS)
            self.bar.set_fraction(1.0)
            self.show_steps()
            GLib.timeout_add(600, lambda: (self.progress.set_visible(False), self.meaning.set_visible(True),
                                           self.chat_intro.set_visible(True)) and False)
        else:
            self.progress.set_visible(False)
            self.chat_intro.set_visible(True)

    def show_results(self, shown):
        self.left_empty.set_visible(not shown)
        self.versions.set_visible(shown)

    def stop(self):
        if self.proc:
            self.proc.force_exit()
            self.proc = None

    def analyze(self):
        text = self.draft()
        if not text:
            self.toasts.add_toast(Adw.Toast(title="Type a message first", timeout=2))
            return
        self.stop()
        self.analysis = None
        self.history = []
        clear(self.chat)
        self.chat_intro.set_visible(True)
        self.started = time.monotonic()
        self.set_status("Checking…")
        self.left_empty.set_text("Versions appear here as soon as they are ready.")
        self.start_progress()
        proc = Gio.Subprocess.new([BACKEND, "--json", "--stream"],
                                  Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDOUT_PIPE
                                  | Gio.SubprocessFlags.STDERR_PIPE)
        self.proc = proc
        stdin = proc.get_stdin_pipe()
        stdin.write_bytes(GLib.Bytes.new(text.encode()), None)
        stdin.close(None)
        stream = Gio.DataInputStream.new(proc.get_stdout_pipe())
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.on_line, (proc, stream))

    def on_line(self, stream, result, data):
        proc, _ = data
        if proc is not self.proc:
            return  # replaced or closed
        line, _ = stream.read_line_finish_utf8(result)
        if line is None:
            proc.wait_async(None, self.on_exit, None)
            return
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            obj = None
        if obj and "stage" in obj:
            self.set_stage(obj["stage"])
        elif obj:
            self.analysis = obj
            self.render()
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.on_line, data)

    def on_exit(self, proc, result, _):
        proc.wait_finish(result)
        if proc is not self.proc:
            return
        self.proc = None
        if proc.get_exit_status() == 0 and self.analysis and self.analysis.get("done"):
            self.set_status(f"Checked in {self.analysis.get('ms', 0) / 1000:.1f} s")
            self.stop_progress(True)
            self.render()
            return
        self.stop_progress(False)
        err = proc.get_stderr_pipe().read_bytes(4096, None).get_data().decode(errors="replace").strip()
        err = re.sub(r"^saywell \[\w+\]: ", "", err) or "the check failed"
        self.set_status("Check failed")
        self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(err[:120]), timeout=6))

    # ---- rendering --------------------------------------------------------

    def render(self):
        a = self.analysis
        done = a.get("done")
        if not done:
            self.set_status(f"Checking… {time.monotonic() - self.started:.0f} s")
        self.show_results(True)
        self.render_versions(a)
        if done:
            self.render_meaning(a, done)

    def render_versions(self, a):
        self._rendering = True
        clear(self.versions)
        texts = {"fixed": (a.get("fixed"), a.get("fixed_zh")),
                 "improved": (a.get("improved"), a.get("improved_zh")),
                 "mine": (self.draft(), None)}
        for key, name, keys in self.VERSIONS:
            text, zh = texts[key]
            if not text:
                continue
            card = vbox(6)
            head = Gtk.Box()
            head.append(label(name, "eyebrow", wrap=False))
            head.append(Gtk.Box(hexpand=True))
            head.append(label(keys, "kbd", wrap=False))
            card.append(head)
            if key == "mine":
                card.append(label(html.escape(text), "version-text", markup=True))
            else:
                markup, changes = highlight_markup(a["original"], text)
                card.append(label(markup, "version-text", markup=True))
                if changes:
                    card.set_tooltip_text("Changes:\n" + "\n".join(changes))
            if zh:
                card.append(label(f"含义  {zh}", "muted"))
            if key == "improved" and a.get("why"):
                card.append(label(f"为什么  {a['why']}", "dim"))
            r = Gtk.ListBoxRow(child=card)
            r.key = key
            r.update_property([Gtk.AccessibleProperty.LABEL], [self.NAMES[key]])
            self.versions.append(r)
            if key == self.choice:
                self.versions.select_row(r)
        self._rendering = False

    def render_meaning(self, a, done):
        clear(self.meaning)
        flags = a.get("meaning_flags") or []
        if flags:
            card = vbox(4, "warn-card")
            tone_only = all(f.startswith("（语气）") for f in flags)
            card.append(label("◐  TONE CHANGED" if tone_only else "⚠  MEANING MAY HAVE CHANGED", "eyebrow"))
            for f in flags:
                card.append(label(f"• {f}"))
            self.meaning.append(card)
        elif done:
            self.meaning.append(label("✓  Meaning unchanged — still compare the 含义 lines with what you meant",
                                      "ok-line"))

    def on_row_selected(self, _list, row):
        if row is not None and not getattr(self, "_rendering", False):
            self.choice = row.key
        if row is not None:
            self.insert_hint.word.set_text(f"Insert {self.NAMES[self.choice]}")

    def pick(self, key):
        for r in list(self.versions):
            if getattr(r, "key", None) == key:
                self.versions.select_row(r)

    def use_as_draft(self, key):
        """Put a version into the draft box so the user can keep writing from it; the window stays open."""
        if not self.analysis or key == "mine":
            self.set_focus(self.input)
            return
        text = self.analysis.get(key) or ""
        if not text:
            return
        buf = self.input.get_buffer()
        buf.set_text(text)
        buf.place_cursor(buf.get_end_iter())
        self.set_focus(self.input)
        self.toasts.add_toast(Adw.Toast(title=f"{self.NAMES[key]} version moved to the draft · ⌃↵ to check again",
                                        timeout=3))

    # ---- follow-up questions ---------------------------------------------

    def on_ask(self, entry):
        question = entry.get_text().strip()
        if not question:
            return
        if not self.analysis or not self.analysis.get("done"):
            self.toasts.add_toast(Adw.Toast(title="Check the draft first", timeout=2))
            return
        entry.set_text("")
        context = {**self.analysis, "history": [{"q": qa["q"], "a": qa["a"]} for qa in self.history if qa["a"]]}
        bubble = label(question, "bubble-me", selectable=True)
        bubble.set_halign(Gtk.Align.END)
        bubble.set_max_width_chars(40)
        self.chat.append(bubble)
        answer = label("Thinking…", "answer dim", selectable=True)
        self.chat.append(answer)
        qa = {"q": question, "a": "", "label": answer}
        self.history.append(qa)
        self.scroll_chat()
        proc = Gio.Subprocess.new([BACKEND, "--ask", question],
                                  Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDOUT_PIPE
                                  | Gio.SubprocessFlags.STDERR_PIPE)
        proc.communicate_utf8_async(json.dumps(context, ensure_ascii=False), None, self.on_answer, qa)

    def on_answer(self, proc, result, qa):
        _, out, err = proc.communicate_utf8_finish(result)
        ok = proc.get_exit_status() == 0
        qa["a"] = (out if ok else err).strip()
        if qa in self.history:
            qa["label"].remove_css_class("dim")
            qa["label"].set_markup(md_markup(qa["a"]) if ok else GLib.markup_escape_text(f"Error: {qa['a']}"))
            self.scroll_chat()

    def scroll_chat(self):
        adj = self.right_scroll.get_vadjustment()
        GLib.idle_add(lambda: adj.set_value(adj.get_upper()) and False)

    # ---- insert -----------------------------------------------------------

    def insert(self):
        if self.choice == "mine" or not self.analysis:
            text = self.draft()
        else:
            text = self.analysis.get(self.choice) or self.analysis.get("fixed") or ""
        if not text:
            self.toasts.add_toast(Adw.Toast(title="Nothing to insert", timeout=2))
            return
        self.inserted = text
        self.close()


def paste_into(target, text):
    """Focus the window we came from and paste text there via the clipboard.
    Pasting, not typing, keeps fcitx5 out of the way and keeps newlines from sending a chat message."""
    subprocess.run(["wl-copy"], input=text.encode(), check=False)
    if target:
        subprocess.run(["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{target["address"]}" }})'],
                       capture_output=True, check=False)
    time.sleep(0.3)  # let focus settle and the hotkey's modifiers be released
    mods = ["ctrl", "shift"] if target and TERMINALS.search(target.get("class", "")) else ["ctrl"]
    cmd = ["wtype"]
    for m in mods:
        cmd += ["-M", m]
    cmd += ["-k", "v"]
    for m in reversed(mods):
        cmd += ["-m", m]
    subprocess.run(cmd, check=False)


def active_window():
    try:
        out = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=2).stdout
        win = json.loads(out)
        return win if win.get("address") else None
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        return None


def main():
    # Remember where the cursor is before our window takes focus.
    target = active_window()
    app = Adw.Application(application_id=APP_ID)
    windows = []

    def on_activate(app):
        if windows:  # hotkey pressed again: just raise the open window
            windows[0].present()
            return
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        css = Gtk.CssProvider()
        css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        windows.append(Popup(app))
        windows[0].present()

    app.connect("activate", on_activate)
    app.run([sys.argv[0]])
    if windows and windows[0].inserted:
        paste_into(target, windows[0].inserted)


if __name__ == "__main__":
    main()
