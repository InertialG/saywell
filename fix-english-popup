#!/usr/bin/env python3
"""fix-english-popup: a libadwaita dialog for writing English with help, bound to a Hyprland hotkey.

Type a draft (mixing Chinese is fine), press Ctrl+Enter to analyze it with `fix-english --json`,
pick a version, and press Ctrl+Shift+Enter: the window closes and the text is pasted where the
cursor was in the window you came from.

Keys:
  Ctrl+Enter        analyze the draft (again)
  Alt+1 / 2 / 3     pick fixed / improved / my draft
  Ctrl+Shift+Enter  insert the picked version into the previous window
  Enter (Ask box)   ask a follow-up question about the English
  Esc               close without inserting
"""

import difflib
import html
import json
import os
import re
import shutil
import subprocess
import sys
import time

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

APP_ID = "uno.guan810.FixEnglish"
# Terminals paste with Ctrl+Shift+V; everything else with Ctrl+V.
TERMINALS = re.compile(r"ghostty|foot|alacritty|kitty|wezterm|konsole|terminal", re.I)
# Prefer the fix-english next to this script, so the repo copy runs its own backend.
HERE = os.path.dirname(os.path.realpath(__file__))
BACKEND = os.path.join(HERE, "fix-english") if os.path.exists(os.path.join(HERE, "fix-english")) \
    else shutil.which("fix-english") or "fix-english"

# A compact dialog in the style of a Windows password prompt: Hyprland dims the rest of the screen
# and the window is slightly translucent. Everything else is stock libadwaita.
CSS = """
window.popup { background-color: alpha(@window_bg_color, 0.95); }
window.popup headerbar { background-color: transparent; box-shadow: none; }
.draft textview, .draft textview text { background-color: transparent; }
.draft textview { padding: 12px; }
"""


def colors():
    """Pango markup for inserted and deleted words, readable on the current light or dark style."""
    dark = Adw.StyleManager.get_default().get_dark()
    ins, dele = ("#8ff0a4", "#ff7b63") if dark else ("#1b7a3d", "#c01c28")
    return (f'<span foreground="{ins}" weight="bold">{{}}</span>',
            f'<span foreground="{dele}" strikethrough="true">{{}}</span>')


def diff_markup(old, new):
    """Word-level diff of new against old as Pango markup."""
    tokenize = lambda s: re.findall(r"\s+|\w+|[^\w\s]", s)
    a, b = tokenize(old), tokenize(new)
    out = []
    for op, i1, i2, j1, j2 in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes():
        if op == "equal":
            out.append(html.escape("".join(a[i1:i2])))
            continue
        removed, added = "".join(a[i1:i2]), "".join(b[j1:j2])
        if removed.strip():
            out.append(colors()[1].format(html.escape(removed)))
            if added.strip():
                out.append(" ")  # visual gap between the old and new words
        if added.strip():
            out.append(colors()[0].format(html.escape(added)))
        elif added:
            out.append(added)
    return "".join(out)


def md_markup(text):
    """Escape text and turn **bold** and `code` into Pango markup."""
    text = html.escape(text)
    text = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", text)
    return re.sub(r"`([^`]+)`", r"<tt>\1</tt>", text)


def row(title, subtitle="", markup=False):
    """An ActionRow whose title and subtitle wrap instead of being cut off."""
    r = Adw.ActionRow(title=title if markup else GLib.markup_escape_text(title),
                      subtitle=subtitle if markup else GLib.markup_escape_text(subtitle),
                      title_lines=0, subtitle_lines=0, title_selectable=True)
    return r


def icon(name, css=None):
    img = Gtk.Image(icon_name=name)
    if css:
        img.add_css_class(css)
    return img


class Popup(Adw.ApplicationWindow):
    VERSIONS = (("fixed", "Fixed", "Alt+1"), ("improved", "Improved", "Alt+2"), ("mine", "My draft", "Alt+3"))

    def __init__(self, app):
        super().__init__(application=app, title="Fix English", default_width=760, default_height=640)
        self.add_css_class("popup")
        self.analysis = None        # latest --json result
        self.history = []           # follow-up questions and answers
        self.proc = None            # running analysis
        self.choice = "fixed"
        self.checks = {}
        self.inserted = None        # text to paste after the window closes

        header = Adw.HeaderBar(show_start_title_buttons=False, show_end_title_buttons=False)
        cancel = Gtk.Button(label="Cancel", tooltip_text="Esc")
        cancel.connect("clicked", lambda _b: self.close())
        header.pack_start(cancel)
        insert = Gtk.Button(label="Insert", tooltip_text="Paste the selected version where your cursor was "
                                                         "(Ctrl+Shift+Enter)")
        insert.add_css_class("suggested-action")
        insert.connect("clicked", lambda _b: self.insert())
        header.pack_end(insert)

        # Draft: a multi-line text view in a card, with a placeholder while it is empty.
        self.input = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, accepts_tab=False)
        self.input.update_property([Gtk.AccessibleProperty.LABEL], ["Draft"])
        placeholder = Gtk.Label(label="Type your message; Chinese words are fine", xalign=0, yalign=0,
                                margin_start=12, margin_top=12, can_target=False)
        placeholder.add_css_class("dimmed")
        buf = self.input.get_buffer()
        buf.connect("changed", lambda b: placeholder.set_visible(b.get_char_count() == 0))
        overlay = Gtk.Overlay(child=Gtk.ScrolledWindow(child=self.input, min_content_height=96,
                                                       max_content_height=180, propagate_natural_height=True))
        overlay.add_overlay(placeholder)
        overlay.add_css_class("card")
        overlay.add_css_class("draft")

        self.spinner = Adw.Spinner(visible=False)
        self.status = Gtk.Label(xalign=0, hexpand=True)
        self.status.add_css_class("caption")
        self.status.add_css_class("dimmed")
        check = Gtk.Button(label="Check", tooltip_text="Check the English (Ctrl+Enter)")
        check.connect("clicked", lambda _b: self.analyze())
        status_row = Gtk.Box(spacing=6)
        for w in (self.spinner, self.status, check):
            status_row.append(w)

        # Results: versions, meaning check and notes are rebuilt on every update; Ask stays put
        # so its entry keeps focus and text while answers arrive.
        self.results = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        self.ask_group = Adw.PreferencesGroup(title="Ask", visible=False)
        self.ask = Adw.EntryRow(title="Ask about the English, e.g. why not \u201censure\u201d?",
                                show_apply_button=True)
        self.ask.connect("entry-activated", self.on_ask)
        self.ask.connect("apply", self.on_ask)
        self.ask_group.add(self.ask)
        self.answer_rows = []

        results_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18, margin_top=6, margin_bottom=12)
        results_box.append(self.results)
        results_box.append(self.ask_group)
        scroll = Gtk.ScrolledWindow(child=Adw.Clamp(child=results_box, maximum_size=720), vexpand=True,
                                    hscrollbar_policy=Gtk.PolicyType.NEVER)

        top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        top.append(overlay)
        top.append(status_row)
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_start=12, margin_end=12)
        content.append(Adw.Clamp(child=top, maximum_size=720))
        content.append(scroll)

        self.toasts = Adw.ToastOverlay(child=content)
        view = Adw.ToolbarView(content=self.toasts, top_bar_style=Adw.ToolbarStyle.FLAT)
        view.add_top_bar(header)
        self.set_content(view)
        self.set_status()

        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        self.connect("close-request", lambda *_: self.stop() or False)
        self.set_focus(self.input)

    # ---- keys -------------------------------------------------------------

    def on_key(self, _ctl, keyval, _code, state):
        ctrl = state & Gdk.ModifierType.CONTROL_MASK
        shift = state & Gdk.ModifierType.SHIFT_MASK
        alt = state & Gdk.ModifierType.ALT_MASK
        if keyval == Gdk.KEY_Escape:
            self.close()
        elif keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and ctrl and shift:
            self.insert()
        elif keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and ctrl:
            self.analyze()
        elif alt and keyval in (Gdk.KEY_1, Gdk.KEY_2, Gdk.KEY_3):
            self.pick(self.VERSIONS[keyval - Gdk.KEY_1][0])
        else:
            return False
        return True

    # ---- analysis ---------------------------------------------------------

    def draft(self):
        buf = self.input.get_buffer()
        return buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip()

    def set_status(self, text="Ctrl+Enter to check", busy=False):
        self.status.set_text(text)
        self.spinner.set_visible(busy)

    def stop(self):
        if self.proc:
            self.proc.force_exit()
            self.proc = None

    def analyze(self):
        text = self.draft()
        if not text:
            self.toasts.add_toast(Adw.Toast(title="Type a message first", timeout=2))
            return
        self.stop()
        self.analysis = None
        for qa in self.history:
            self.ask_group.remove(qa["row"])
        self.history = []
        self.started = time.monotonic()
        self.set_status("Checking…", busy=True)
        self.clear()
        proc = Gio.Subprocess.new([BACKEND, "--json", "--stream"],
                                  Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDOUT_PIPE
                                  | Gio.SubprocessFlags.STDERR_PIPE)
        self.proc = proc
        stdin = proc.get_stdin_pipe()
        stdin.write_bytes(GLib.Bytes.new(text.encode()), None)
        stdin.close(None)
        stream = Gio.DataInputStream.new(proc.get_stdout_pipe())
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.on_line, (proc, stream))

    def on_line(self, stream, result, data):
        proc, _ = data
        if proc is not self.proc:
            return  # replaced or closed
        line, _ = stream.read_line_finish_utf8(result)
        if line is None:
            proc.wait_async(None, self.on_exit, None)
            return
        try:
            self.analysis = json.loads(line)
            self.render()
        except json.JSONDecodeError:
            pass
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.on_line, data)

    def on_exit(self, proc, result, _):
        proc.wait_finish(result)
        if proc is not self.proc:
            return
        self.proc = None
        if proc.get_exit_status() == 0 and self.analysis and self.analysis.get("done"):
            self.set_status(f"Checked in {self.analysis.get('ms', 0) / 1000:.1f} s · Ctrl+Enter to check again")
            self.render()
            return
        err = proc.get_stderr_pipe().read_bytes(4096, None).get_data().decode(errors="replace").strip()
        err = re.sub(r"^fix-english \[\w+\]: ", "", err) or "the check failed"
        self.set_status("Check failed · Ctrl+Enter to try again")
        self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(err[:120]), timeout=6))

    # ---- rendering --------------------------------------------------------

    def clear(self):
        while child := self.results.get_first_child():
            self.results.remove(child)
        self.ask_group.set_visible(False)

    def render(self):
        a = self.analysis
        done = a.get("done")
        self.clear()
        if not done:
            self.set_status(f"Checking… {time.monotonic() - self.started:.0f} s", busy=True)

        versions = Adw.PreferencesGroup(title="Versions")
        group, self.checks = None, {}
        texts = {"fixed": (a.get("fixed"), a.get("fixed_zh")),
                 "improved": (a.get("improved"), a.get("improved_zh")),
                 "mine": (self.draft(), None)}
        for key, name, keys in self.VERSIONS:
            text, zh = texts[key]
            if not text:
                continue
            title = diff_markup(a["original"], text) if key != "mine" else GLib.markup_escape_text(text)
            sub = [f"含义：{GLib.markup_escape_text(zh)}"] if zh else []
            if key == "improved" and a.get("why"):
                sub.append(f"为什么：{GLib.markup_escape_text(a['why'])}")
            r = row(title, "\n".join(sub), markup=True)
            check = Gtk.CheckButton(group=group, active=(key == self.choice), valign=Gtk.Align.CENTER)
            check.update_property([Gtk.AccessibleProperty.LABEL], [name])
            check.connect("toggled", lambda c, k=key: c.get_active() and setattr(self, "choice", k))
            group = group or check
            self.checks[key] = check
            r.add_prefix(check)
            r.set_activatable_widget(check)
            tag = Gtk.Label(label=name, tooltip_text=keys, valign=Gtk.Align.CENTER)
            tag.add_css_class("caption")
            tag.add_css_class("dimmed")
            r.add_suffix(tag)
            versions.add(r)
        self.results.append(versions)

        if a.get("meaning_flags") or done:
            meaning = Adw.PreferencesGroup(title="Meaning")
            for f in a.get("meaning_flags", []):
                r = row(f)
                r.add_prefix(icon("dialog-warning-symbolic", "warning"))
                meaning.add(r)
            if not a.get("meaning_flags"):
                r = row("No change in meaning found", "Still compare the 含义 lines with what you meant")
                r.add_prefix(icon("emblem-ok-symbolic", "success"))
                meaning.add(r)
            self.results.append(meaning)

        if a.get("notes"):
            notes = Adw.PreferencesGroup(title="Notes")
            for n in a["notes"]:
                notes.add(row(n["point"], n.get("detail", "")))
            self.results.append(notes)

        self.ask_group.set_visible(bool(done))

    def pick(self, key):
        if key in self.checks:
            self.checks[key].set_active(True)

    # ---- follow-up questions ---------------------------------------------

    def on_ask(self, entry):
        question = entry.get_text().strip()
        if not question or not self.analysis or not self.analysis.get("done"):
            return
        entry.set_text("")
        context = {**self.analysis, "history": [qa for qa in self.history if qa["a"]]}
        qa = {"q": question, "a": ""}
        self.history.append(qa)
        r = row(question, "Thinking…")
        self.ask_group.add(r)
        qa["row"] = r
        proc = Gio.Subprocess.new([BACKEND, "--ask", question],
                                  Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDOUT_PIPE
                                  | Gio.SubprocessFlags.STDERR_PIPE)
        proc.communicate_utf8_async(json.dumps(context, ensure_ascii=False, default=str), None,
                                    self.on_answer, qa)

    def on_answer(self, proc, result, qa):
        _, out, err = proc.communicate_utf8_finish(result)
        ok = proc.get_exit_status() == 0
        qa["a"] = (out if ok else err).strip()
        if qa in self.history:
            qa["row"].set_subtitle(md_markup(qa["a"]) if ok else GLib.markup_escape_text(f"Error: {qa['a']}"))

    # ---- insert -----------------------------------------------------------

    def insert(self):
        if self.choice == "mine" or not self.analysis:
            text = self.draft()
        else:
            text = self.analysis.get(self.choice) or self.analysis.get("fixed") or ""
        if not text:
            self.toasts.add_toast(Adw.Toast(title="Nothing to insert", timeout=2))
            return
        self.inserted = text
        self.close()


def paste_into(target, text):
    """Focus the window we came from and paste text there via the clipboard.
    Pasting, not typing, keeps fcitx5 out of the way and keeps newlines from sending a chat message."""
    subprocess.run(["wl-copy"], input=text.encode(), check=False)
    if target:
        subprocess.run(["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{target["address"]}" }})'],
                       capture_output=True, check=False)
    time.sleep(0.3)  # let focus settle and the hotkey's modifiers be released
    mods = ["ctrl", "shift"] if target and TERMINALS.search(target.get("class", "")) else ["ctrl"]
    cmd = ["wtype"]
    for m in mods:
        cmd += ["-M", m]
    cmd += ["-k", "v"]
    for m in reversed(mods):
        cmd += ["-m", m]
    subprocess.run(cmd, check=False)


def active_window():
    try:
        out = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=2).stdout
        win = json.loads(out)
        return win if win.get("address") else None
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        return None


def main():
    # Remember where the cursor is before our window takes focus.
    target = active_window()
    app = Adw.Application(application_id=APP_ID)
    windows = []

    def on_activate(app):
        if windows:  # hotkey pressed again: just raise the open window
            windows[0].present()
            return
        css = Gtk.CssProvider()
        css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        windows.append(Popup(app))
        windows[0].present()

    app.connect("activate", on_activate)
    app.run([sys.argv[0]])
    if windows and windows[0].inserted:
        paste_into(target, windows[0].inserted)


if __name__ == "__main__":
    main()
